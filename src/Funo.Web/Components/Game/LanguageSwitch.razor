@using Funo.Web.Localization
@implements IDisposable
@inject LanguageState Language

<div class="lang-switch" role="group" aria-label="Language / Dil">
    <button type="button"
            class="lang-btn @(Language.Current == Lang.Tr ? "active" : "")"
            aria-pressed="@(Language.Current == Lang.Tr)"
            @onclick="() => Language.Set(Lang.Tr)">TR</button>
    <button type="button"
            class="lang-btn @(Language.Current == Lang.En ? "active" : "")"
            aria-pressed="@(Language.Current == Lang.En)"
            @onclick="() => Language.Set(Lang.En)">EN</button>
</div>

@code {
    protected override void OnInitialized() => Language.Changed += OnLanguageChanged;

    private void OnLanguageChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Language.Changed -= OnLanguageChanged;
}
