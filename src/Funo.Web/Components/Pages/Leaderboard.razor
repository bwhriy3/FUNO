@page "/leaderboard"
@using Funo.Web.Data
@using Microsoft.EntityFrameworkCore
@inject FunoDbContext Db

<PageTitle>fUNO — Leaderboard</PageTitle>

<div class="table" lang="en">
    <div class="table-top">
        <h1>Leaderboard</h1>
        <a class="btn ghost" href="/">Back</a>
    </div>

    @if (_rows is null)
    {
        <p class="thinking">Loading…</p>
    }
    else if (_totalCount == 0)
    {
        <p class="thinking">No finished games yet. Play one!</p>
    }
    else
    {
        <div class="lobby-players">
            <table class="leaderboard-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Player</th>
                        <th>Wins</th>
                        <th>Games</th>
                        <th>Win rate</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < _rows.Count; i++)
                    {
                        var row = _rows[i];
                        <tr>
                            <td>@(FirstRowNumber + i)</td>
                            <td>@row.PlayerName</td>
                            <td>@row.Wins</td>
                            <td>@row.Games</td>
                            <td>@row.WinRate.ToString("P0")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (TotalPages > 1)
        {
            <div class="pagination">
                @if (CurrentPage > 1)
                {
                    <a class="btn ghost" href="@PageUrl(CurrentPage - 1)">&larr; Prev</a>
                }
                else
                {
                    <span class="btn ghost" aria-disabled="true">&larr; Prev</span>
                }

                <span class="pagination-status">Page @CurrentPage of @TotalPages</span>

                @if (CurrentPage < TotalPages)
                {
                    <a class="btn ghost" href="@PageUrl(CurrentPage + 1)">Next &rarr;</a>
                }
                else
                {
                    <span class="btn ghost" aria-disabled="true">Next &rarr;</span>
                }
            </div>
        }
    }
</div>

@code {
    private const int PageSize = 10;

    [SupplyParameterFromQuery(Name = "page")]
    public int? PageParam { get; set; }

    private List<Row>? _rows;
    private int _totalCount;

    private int CurrentPage => Math.Clamp(PageParam ?? 1, 1, Math.Max(1, TotalPages));
    private int TotalPages => (int)Math.Ceiling(_totalCount / (double)PageSize);
    private int FirstRowNumber => (CurrentPage - 1) * PageSize + 1;

    private sealed record Row(string PlayerName, int Wins, int Games)
    {
        public double WinRate => Games == 0 ? 0 : (double)Wins / Games;
    }

    protected override async Task OnInitializedAsync()
    {
        // Botlar tablo disi birakilir - burada gercek oyunculari kiyasliyoruz.
        var grouped = await Db.MatchSeats
            .Where(s => !s.IsBot)
            .GroupBy(s => s.PlayerName)
            .Select(g => new
            {
                PlayerName = g.Key,
                Games = g.Count(),
                Wins = g.Count(s => s.IsWinner)
            })
            .ToListAsync();

        var allRows = grouped
            .Select(g => new Row(g.PlayerName, g.Wins, g.Games))
            .OrderByDescending(r => r.Wins)
            .ThenByDescending(r => r.WinRate)
            .ThenBy(r => r.PlayerName, StringComparer.OrdinalIgnoreCase)
            .ToList();

        _totalCount = allRows.Count;
        _rows = allRows.Skip((CurrentPage - 1) * PageSize).Take(PageSize).ToList();
    }

    private string PageUrl(int page) => $"/leaderboard?page={page}";
}
